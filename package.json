{
  "name": "docfy-mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "MCP server exposing a nestjs-docfy-documented OpenAPI catalog as tools for coding agents",
  "bin": {
    "docfy-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "author": "Marvin Rocha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarvinRF/docfy-mcp.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "docfy-core": "^0.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
